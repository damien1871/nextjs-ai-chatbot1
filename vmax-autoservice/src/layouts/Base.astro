---
import '@fontsource/barlow-condensed/latin-600.css';
import '@fontsource/barlow-condensed/latin-700.css';
import '@fontsource/barlow/latin-400.css';
import '@fontsource/barlow/latin-500.css';
import '@fontsource/barlow/latin-600.css';
import '../styles/global.css';

import fontDisplay from '@fontsource/barlow-condensed/files/barlow-condensed-latin-700-normal.woff2?url';
import fontText from '@fontsource/barlow/files/barlow-latin-400-normal.woff2?url';

import { betrieb, oeffnungszeiten, NOINDEX, seo } from '../data/betrieb';
import Platzhalter from '../components/Platzhalter.astro';

interface Props {
  title?: string;
  description?: string;
  /** Pfad mit abschließendem Slash, z. B. "/impressum/" */
  path?: string;
  /** Unterseiten ohne SEO-Bedeutung */
  noindex?: boolean;
}

const { title = seo.titel, description = seo.beschreibung, path = '/', noindex = false } = Astro.props;

const canonical = new URL(path, Astro.site).href;
const ogImage = new URL('/og-image.png', Astro.site).href;
const robots = NOINDEX || noindex ? 'noindex, nofollow' : 'index, follow';

// Strukturierte Daten: nur gelieferte Fakten. Bewusst ohne aggregateRating (Selbstbewertungen
// werden von Google nicht als Rich Result angezeigt).
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'AutoRepair',
  '@id': `${new URL('/', Astro.site).href}#werkstatt`,
  name: betrieb.name,
  url: new URL('/', Astro.site).href,
  telephone: betrieb.telefonSchema,
  address: {
    '@type': 'PostalAddress',
    streetAddress: betrieb.strasse,
    postalCode: betrieb.plz,
    addressLocality: betrieb.ort,
    addressCountry: 'DE',
  },
  geo: { '@type': 'GeoCoordinates', latitude: betrieb.geo.lat, longitude: betrieb.geo.lon },
  openingHoursSpecification: oeffnungszeiten
    .filter((z) => z.von)
    .map((z) => ({
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: z.schema,
      opens: z.von!.padStart(5, '0'),
      closes: z.bis,
    })),
};

const jahr = new Date().getFullYear();
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="theme-color" content="#1c1f22" />
    <link rel="canonical" href={canonical} />

    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="de_DE" />
    <meta property="og:site_name" content={betrieb.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="V-MAX Autoservice, Kfz-Werkstatt Groß-Umstadt" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preload" as="font" type="font/woff2" href={fontDisplay} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href={fontText} crossorigin />

    <!-- Datenblock, kein ausführbares Script: von script-src nicht betroffen -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')} />
  </head>
  <body class="pb-24 md:pb-0">
    <a
      href="#inhalt"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:bg-signal focus:px-4 focus:py-3 focus:font-semibold focus:text-anthrazit"
    >
      Zum Inhalt springen
    </a>

    <header class="border-b border-stahl">
      <div class="container-seite flex flex-wrap items-center justify-between gap-x-6 gap-y-2 py-3">
        <a href="/" class="flex min-h-11 flex-wrap items-center gap-x-3 gap-y-1">
          <Platzhalter text="Logo" />
          <span class="font-display text-2xl leading-none font-bold">{betrieb.name}</span>
        </a>
        <nav aria-label="Hauptnavigation" class="hidden items-center gap-1 lg:flex">
          {
            [
              ['/#leistungen', 'Leistungen'],
              ['/#ablauf', 'Ablauf'],
              ['/#zeiten', 'Öffnungszeiten'],
              ['/#kontakt', 'Kontakt'],
            ].map(([href, label]) => (
              <a href={href} class="inline-flex min-h-11 items-center px-3 hover:text-signal">
                {label}
              </a>
            ))
          }
        </nav>
        <a
          href={`tel:${betrieb.telefonHref}`}
          class="hidden min-h-11 items-center font-display text-2xl font-semibold hover:text-signal md:inline-flex"
        >
          {betrieb.telefonAnzeige}
        </a>
      </div>
    </header>

    <main id="inhalt" tabindex="-1" class="outline-none">
      <slot />
    </main>

    <footer class="border-t border-stahl">
      <div class="container-seite grid gap-8 py-12 md:grid-cols-3">
        <div>
          <p class="font-display text-3xl leading-none font-bold">{betrieb.name}</p>
          <address class="mt-4 not-italic">
            {betrieb.strasse}<br />
            {betrieb.plz} {betrieb.ort}
          </address>
        </div>
        <div>
          <p class="text-stahl-hell">Kontakt</p>
          <a
            href={`tel:${betrieb.telefonHref}`}
            class="mt-1 inline-flex min-h-11 items-center font-display text-2xl font-semibold hover:text-signal"
          >
            {betrieb.telefonAnzeige}
          </a>
          <p class="text-stahl-hell">Mo–Sa 9:00–18:00 Uhr</p>
        </div>
        <nav aria-label="Rechtliches">
          <p class="text-stahl-hell">Rechtliches</p>
          <ul class="mt-1">
            <li><a class="inline-flex min-h-11 items-center underline underline-offset-4 hover:text-signal" href="/impressum/">Impressum</a></li>
            <li><a class="inline-flex min-h-11 items-center underline underline-offset-4 hover:text-signal" href="/datenschutz/">Datenschutz</a></li>
          </ul>
        </nav>
      </div>
      <div class="border-t border-stahl">
        <p class="container-seite py-4 text-stahl-hell">© {jahr} {betrieb.name}</p>
      </div>
    </footer>

    <!-- Sticky-Anrufleiste, nur Smartphone-Breite; rein CSS -->
    <div class="fixed inset-x-0 bottom-0 z-40 border-t border-stahl bg-anthrazit p-3 pb-[max(0.75rem,env(safe-area-inset-bottom))] md:hidden">
      <a href={`tel:${betrieb.telefonHref}`} class="btn btn-primaer w-full">Jetzt anrufen</a>
    </div>
  </body>
</html>
