---
import Base from '../layouts/Base.astro';
---
<Base title="Seite nicht gefunden | V-MAX Autoservice" description="Diese Seite gibt es nicht." path="/404/" noindex>
  <section class="container-seite py-24 md:py-32">
    <h1 class="text-6xl md:text-8xl">Diese Seite gibt es nicht</h1>
    <p class="mt-6">Zurück zur Startseite oder gleich anrufen.</p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row">
      <a href="/" class="btn btn-sekundaer">Zur Startseite</a>
    </div>
  </section>
</Base>
