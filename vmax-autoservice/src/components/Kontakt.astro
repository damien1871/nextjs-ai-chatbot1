---
import { betrieb } from '../data/betrieb';
import Platzhalter from './Platzhalter.astro';
---
<section id="kontakt" aria-labelledby="h-kontakt">
  <div class="container-seite py-16 md:py-24">
    <h2 id="h-kontakt" class="text-6xl md:text-8xl">Kontakt</h2>

    <div class="mt-10 grid gap-10 lg:grid-cols-12">
      <div class="min-w-0 lg:col-span-7">
        <p class="text-stahl-hell">Am schnellsten erreichen Sie uns per Telefon:</p>
        <a
          href={`tel:${betrieb.telefonHref}`}
          class="mt-2 inline-block font-display text-[clamp(3rem,13vw,7.5rem)] leading-none font-bold underline decoration-signal decoration-4 underline-offset-8 hover:text-signal"
        >
          {betrieb.telefonAnzeige}
        </a>
        <div class="mt-8">
          <a href={`tel:${betrieb.telefonHref}`} class="btn btn-primaer">Jetzt anrufen</a>
        </div>
      </div>
      <div class="min-w-0 lg:col-span-5">
        <p class="text-stahl-hell">Oder schreiben Sie uns:</p>
        <p class="mt-2 text-2xl">
          {
            betrieb.email ? (
              <a class="inline-flex min-h-11 items-center underline underline-offset-4 hover:text-signal" href={`mailto:${betrieb.email}`}>
                {betrieb.email}
              </a>
            ) : (
              <Platzhalter text="E-Mail-Adresse, wird als mailto-Link eingebaut" />
            )
          }
        </p>
        <p class="mt-8">Auch auf der Durchreise liegen geblieben? Rufen Sie an, wir schauen, was möglich ist.</p>
      </div>
    </div>
  </div>
</section>
