---
import { betrieb, oeffnungszeiten, routeUrl } from '../data/betrieb';
import Foto from './Foto.astro';
import Masslinie from './Masslinie.astro';
---
<section id="zeiten" class="border-b border-stahl bg-werkbank" aria-labelledby="h-zeiten">
  <div class="container-seite py-16 md:py-24">
    <h2 id="h-zeiten" class="text-5xl md:text-7xl">Öffnungszeiten und Anfahrt</h2>

    <div class="mt-12 grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="min-w-0 lg:col-span-7">
        <p class="font-display text-[clamp(5rem,22vw,11rem)] leading-[0.85] font-bold" aria-hidden="true">Mo–Sa</p>
        <p class="mt-3 font-display text-4xl font-semibold md:text-5xl" aria-hidden="true">9:00–18:00 Uhr</p>

        <table class="mt-10 w-full border-collapse text-lg">
          <caption class="sr-only">Öffnungszeiten von V-MAX Autoservice</caption>
          <thead class="sr-only">
            <tr><th scope="col">Tag</th><th scope="col">Zeit</th></tr>
          </thead>
          <tbody>
            {
              oeffnungszeiten.map((z) => (
                <tr class="border-t border-stahl">
                  <th scope="row" class="w-1/2 py-3 pr-4 text-left font-medium sm:w-44">{z.tag}</th>
                  <td class="py-3 tabular-nums">
                    {z.von ? `${z.von}–${z.bis} Uhr` : <span class="text-stahl-hell">geschlossen</span>}
                  </td>
                  <td class="hidden w-1/2 py-3 pl-6 md:table-cell" aria-hidden="true">
                    <div class="skala">
                      {Array.from({ length: 9 }).map(() => <span />)}
                      {z.von && <b />}
                    </div>
                  </td>
                </tr>
              ))
            }
          </tbody>
          <tfoot class="hidden md:table-footer-group" aria-hidden="true">
            <tr class="border-t border-stahl text-stahl-hell">
              <td colspan="2"></td>
              <td class="flex justify-between pt-2 pl-6 tabular-nums"><span>9</span><span>12</span><span>15</span><span>18 Uhr</span></td>
            </tr>
          </tfoot>
        </table>
      </div>

      <div class="min-w-0 lg:col-span-5">
        <Foto platzhalter="Foto Einfahrt / Außenansicht für die Anfahrt" class="aspect-video mb-6 lg:aspect-[4/3]" />
        <Masslinie label={betrieb.zusatz} class="mb-6" />
        <address class="text-2xl leading-snug not-italic">
          <span class="font-display text-4xl font-bold">{betrieb.name}</span><br />
          {betrieb.strasse}<br />
          {betrieb.plz} {betrieb.ort}
        </address>
        <p class="mt-3 text-stahl-hell">Im Gewerbegebiet. Für alle aus Groß-Umstadt, Dieburg, Babenhausen, Schaafheim, Otzberg und Umgebung.</p>
        <a href={routeUrl} class="btn btn-primaer mt-8" target="_blank" rel="noopener noreferrer">Route in Google Maps öffnen</a>
      </div>
    </div>
  </div>
</section>
