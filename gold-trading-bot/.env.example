# ============================================================
#  Gold-Trading-Bot – Einstellungen
#  Kopiere diese Datei nach ".env" und trage deine Daten ein.
#  Die .env NIEMALS weitergeben oder hochladen!
# ============================================================

# --- Zugang zu Capital.com (siehe README, Schritt 3) ---
CAPITAL_API_KEY=dein_api_key
CAPITAL_IDENTIFIER=deine_login_email@beispiel.de
CAPITAL_PASSWORD=das_passwort_das_du_beim_api_key_vergeben_hast

# demo = Spielgeld (EMPFOHLEN) | live = echtes Geld
CAPITAL_ENVIRONMENT=demo
# Für Live-Handel zusätzlich auf YES setzen. Nur wenn du weißt, was du tust!
I_UNDERSTAND_LIVE_TRADING_RISK=NO

# --- Markt ---
EPIC=GOLD
# MINUTE_15, MINUTE_30, HOUR, HOUR_4, DAY  (HOUR empfohlen)
RESOLUTION=HOUR

# --- Strategie ---
# trend_pullback oder breakout
STRATEGY=trend_pullback
ADX_MIN=20
ATR_STOP_MULT=2.0
ATR_TARGET_MULT=3.0

# --- Risiko ---
# 0.01 = 1 % des Kontos pro Trade (Anfänger: 0.005)
RISK_PER_TRADE=0.01
# 0.03 = nach 3 % Tagesverlust keine neuen Trades mehr bis morgen
MAX_DAILY_LOSS=0.03
MAX_OPEN_POSITIONS=1
SIZE_STEP=0.01
PRICE_DECIMALS=2

# --- Technik ---
POLL_SECONDS=30
JOURNAL_PATH=logs/trades.csv
LOG_PATH=logs/bot.log
