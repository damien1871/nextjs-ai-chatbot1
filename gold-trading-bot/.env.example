# ============================================================
#  Gold-Trading-Bot – Einstellungen
#  Kopiere diese Datei nach ".env" und trage deine Daten ein.
#  Die .env NIEMALS weitergeben oder hochladen!
# ============================================================

# --- Zugang zu Capital.com (siehe README, Schritt 3) ---
CAPITAL_API_KEY=dein_api_key
CAPITAL_IDENTIFIER=deine_login_email@beispiel.de
CAPITAL_PASSWORD=das_passwort_das_du_beim_api_key_vergeben_hast

# demo = Spielgeld (EMPFOHLEN) | live = echtes Geld
CAPITAL_ENVIRONMENT=demo
# Für Live-Handel zusätzlich auf YES setzen. Nur wenn du weißt, was du tust!
I_UNDERSTAND_LIVE_TRADING_RISK=NO

# --- Markt ---
EPIC=GOLD
# MINUTE_15, MINUTE_30, HOUR, HOUR_4, DAY  (HOUR empfohlen)
RESOLUTION=HOUR

# --- Strategie ---
# trend_pullback, breakout oder session_breakout (Asien-Range-Breakout zur London-Eröffnung)
STRATEGY=trend_pullback
ADX_MIN=20
ATR_STOP_MULT=2.0
# 0 = kein festes Gewinnziel (nur zusammen mit TRAILING_ATR_MULT sinnvoll)
ATR_TARGET_MULT=3.0
# Nachziehender Stop im Abstand von x ATR (0 = aus, typisch 3)
TRAILING_ATR_MULT=0
# Position nach x Kerzen schließen (0 = aus; für session_breakout z. B. 10)
MAX_HOLD_BARS=0
# session_breakout: Asien-Range darf max. 35 % der durchschnittlichen Tagesspanne sein
SESSION_RANGE_MAX=0.35

# --- Wirtschaftskalender-Filter ---
# ON = keine neuen Trades rund um wichtige Termine (Zinsentscheid, Inflation, Arbeitsmarkt)
NEWS_FILTER=ON
NEWS_MINUTES_BEFORE=60
NEWS_MINUTES_AFTER=30
# Welche Währungen/Wichtigkeit (High, Medium, Low). Für Gold zählt vor allem USD.
NEWS_CURRENCIES=USD
NEWS_IMPACT=High

# --- Risiko ---
# 0.01 = 1 % des Kontos pro Trade (Anfänger: 0.005)
RISK_PER_TRADE=0.01
# 0.03 = nach 3 % Tagesverlust keine neuen Trades mehr bis morgen
MAX_DAILY_LOSS=0.03
MAX_OPEN_POSITIONS=1
SIZE_STEP=0.01
PRICE_DECIMALS=2

# --- Technik ---
POLL_SECONDS=30
JOURNAL_PATH=logs/trades.csv
LOG_PATH=logs/bot.log
