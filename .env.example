# Kopiere diese Datei nach ".env.local" und trage deine echten Werte ein.
# ".env.local" wird NICHT ins Git-Repository hochgeladen – deine Schlüssel bleiben geheim.

# --- Anthropic (Pflicht für die Analyse) ---
# Schlüssel aus https://platform.claude.com/ → API Keys
ANTHROPIC_API_KEY=
# Modell für die Analyse (aktuell laut offizieller Doku: claude-opus-5-5)
ANTHROPIC_MODEL=claude-opus-5-5

# --- Brevo (Warteliste mit Double-Opt-in) ---
# Ohne diese Werte funktioniert das Formular im "Testmodus" (nur Log-Ausgabe).
BREVO_API_KEY=
# ID der Kontaktliste in Brevo (Zahl, z. B. 3)
BREVO_LIST_ID=
# ID der Double-Opt-in-Vorlage in Brevo (Zahl)
BREVO_DOI_TEMPLATE_ID=

# Öffentliche Adresse deiner Seite (für die Weiterleitung nach der Bestätigungs-Mail)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Missbrauchsschutz ---
# Maximale Anzahl Analysen pro Besucher (IP-Adresse) und Stunde
RATE_LIMIT_PER_HOUR=5
